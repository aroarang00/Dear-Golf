# Dear Golf — API 키 · 시크릿 템플릿
# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요.
#   PowerShell:  Copy-Item .env.example .env
# Expo는 EXPO_PUBLIC_ 접두사 변수만 앱 번들(process.env)에 주입한다.

# 카카오 디벨로퍼스 (https://developers.kakao.com/console/app)
EXPO_PUBLIC_KAKAO_REST_API_KEY=
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
EXPO_PUBLIC_KAKAO_JS_KEY=

# Firebase (콘솔 → 프로젝트 설정 → 웹 앱)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# 네이버 클라우드 플랫폼 — Maps Static Map API (https://www.ncloud.com)
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=
EXPO_PUBLIC_NAVER_MAP_CLIENT_SECRET=

# Unsplash Access Key (https://unsplash.com/developers)
EXPO_PUBLIC_UNSPLASH_ACCESS_KEY=

# 공공데이터포털 data.go.kr — 기상청 · 에어코리아 공용 인증키
EXPO_PUBLIC_KMA_SERVICE_KEY=

# OpenWeatherMap (https://openweathermap.org/api)
EXPO_PUBLIC_OPENWEATHER_API_KEY=

# Sentry — 에러 모니터링 (https://sentry.io, Settings → Projects → Client Keys (DSN))
EXPO_PUBLIC_SENTRY_DSN=
