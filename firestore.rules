rules_version = '2';

// =============================================================
// Dear Golf — Firestore 보안 규칙
//  - 앱은 익명 인증(signInAnonymously) 기반 — request.auth는 익명 유저도 채워짐
//  - 원칙: 본인 데이터만 쓰기(ownerUid/authorUid == request.auth.uid 강제)
//  - 명시되지 않은 모든 경로는 기본 거부(default deny)
//  - 규칙은 "필터"가 아님 — 목록 쿼리는 클라이언트가 ownerUid 등으로
//    직접 필터해야 통과함 (하단 컬렉션별 주석 참고)
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 공통 헬퍼 =====
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // 두 uid로 친구 문서 ID 생성 — 항상 (작은uid)_(큰uid) 순서로 정렬
    function pairId(a, b) {
      return a < b ? (a + '_' + b) : (b + '_' + a);
    }
    // a와 b가 '수락된' 친구 사이인지 (friendships 문서 조회)
    function areFriends(a, b) {
      return exists(/databases/$(database)/documents/friendships/$(pairId(a, b)))
        && get(/databases/$(database)/documents/friendships/$(pairId(a, b))).data.status == 'accepted';
    }
    // a·b 중 한쪽이라도 상대를 차단했는지 (users.blockedUids 양방향) — DM 전송 차단용.
    //   차단 사실 비노출 정책이라 클라이언트는 사유 없는 중립 실패로 처리 ([[report-block-policy]]).
    function dmBlockedBetween(a, b) {
      return (b in get(/databases/$(database)/documents/users/$(a)).data.get('blockedUids', []))
        || (a in get(/databases/$(database)/documents/users/$(b)).data.get('blockedUids', []));
    }
    // update 시 변경된 필드가 허용 목록 안에만 있는지
    function changedKeysWithin(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }
    // 호출자가 배열에서 '자기 자신'의 포함 여부만 토글했는지 (가입/탈퇴·좋아요)
    function selfMembershipToggled(field) {
      return (request.auth.uid in resource.data[field])
          != (request.auth.uid in request.resource.data[field]);
    }

    // ===== users — 골퍼 프로필 (명함). MY 탭 = 친구 프로필 = 같은 스키마 =====
    // 읽기: 로그인한 누구나 (친구 검색·친구 프로필·모집 작성자 표시에 필요)
    //   ※ 민감 정보(전화번호 등)는 users 문서에 직접 저장하지 말 것
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      allow update: if isOwner(uid) && request.resource.data.uid == uid;
      allow delete: if isOwner(uid);

      // 친구 그룹·별명 (친구 그룹 기능 — docs/friend-groups-design.md). 본인만.
      //   users 문서 read가 전면 개방(위 line)이라 친구메타는 반드시 owner-only 서브컬렉션에 둔다.
      //   서브컬렉션은 부모 규칙을 상속하지 않으므로 여기서 명시.
      match /private/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ===== schedules — 라운딩 예정 일정 (본인만 read/write) =====
    // 클라이언트 쿼리: where('ownerUid','==', 내uid).orderBy('date','asc')
    // dDay·weather 등 파생값은 클라이언트 계산이라 저장 X.
    match /schedules/{scheduleId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;   // ownerUid 변조 금지
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ===== rounds — 라운딩 기록 (구 diaries + 친구 feed 통합) =====
    // 클라이언트 쿼리 규칙 (규칙은 필터가 아님):
    //   · 내 기록      : where('ownerUid','==', 내uid)
    //   · 친구 feed    : where('ownerUid','==', 친구uid).where('visibility','==','friends')
    // 위 형태로 필터해야 list 쿼리가 통과함.
    match /rounds/{roundId} {
      allow read: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid
        || (resource.data.visibility == 'friends'
            && areFriends(request.auth.uid, resource.data.ownerUid))
        // 그룹 공개 — 작성 시점 audienceUids(작성자 친구로 한정)에 포함된 수신자만 ([[friend_groups]])
        || (resource.data.visibility == 'group'
            && request.auth.uid in resource.data.audienceUids)
      );
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.visibility in ['friends', 'group', 'private'];
      allow update: if isSignedIn() && (
        // 본인 — 전체 수정 (ownerUid 변조 금지)
        (resource.data.ownerUid == request.auth.uid
         && request.resource.data.ownerUid == request.auth.uid)
        // 친구 — 친구공개 라운드의 좋아요(likes)에서 자기 uid만 토글 ([[friend-feed-design]])
        || (resource.data.visibility == 'friends'
            && areFriends(request.auth.uid, resource.data.ownerUid)
            && changedKeysWithin(['likes', 'updatedAt'])
            && selfMembershipToggled('likes'))
        // 그룹 공개 글 좋아요 — 수신자(audienceUids)만 자기 uid 토글 ([[friend_groups]])
        || (resource.data.visibility == 'group'
            && request.auth.uid in resource.data.audienceUids
            && changedKeysWithin(['likes', 'updatedAt'])
            && selfMembershipToggled('likes'))
      );
      allow delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // ===== roundScoreShares — 동반자 스코어 공유 (Phase C, docs/companion-design.md §11) =====
    //  한 명이 라운딩 스코어(OCR 카드/총타)를 공유 → 수신자(동반자 friendUid)가 카드에서 '자기 행'을 골라
    //  본인 rounds에 파생. ★자기파생: 파생은 rounds에 ownerUid==본인으로 setDoc(결정적 ID {shareId}_{uid}) →
    //    기존 rounds 규칙 그대로 통과 + 멱등(중복 방지). cross-user 쓰기 0이라 CF 불필요(모집→일정 자동추가와 동일 패턴).
    //  문서 = 임시(공유 후 TTL 클린업 — 후속 CF). rows는 이름 라벨 힌트 포함하나, 영구 저장은 각자 '자기 행'만(PIPA).
    //  필드: { authorUid, course, courseId?, courseLoc?, date, day?, time?, pars:[18]|null,
    //         rows:[{idx,label,holes:[18]|null,total}], audienceUids:[friendUid], respondedUids:[uid],
    //         scheduleId?|roundupId?, createdAt, expiresAt }
    //  respondedUids = 수락(파생)·거절 모두 자기 uid 추가 → 응답하면 카드 안 뜸(재노출 방지, 수락/거절 구분은 파생 round 존재로).
    //  클라이언트 쿼리: where('audienceUids','array-contains', 내uid)  (응답완료 필터는 클라서 respondedUids로)
    match /roundScoreShares/{shareId} {
      allow read: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid
        || request.auth.uid in resource.data.audienceUids
      );
      // 생성: 본인이 author. audience/rows는 리스트, responded는 빈 배열로 시작(self-toggle 전제).
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.audienceUids is list
        && request.resource.data.respondedUids == []
        && request.resource.data.rows is list
        && request.resource.data.course is string
        && request.resource.data.date is string;
      // 수신자 응답: respondedUids에 '자기 uid'만 토글. rows·audience 등 불변(말풍선 위조·남행 변조 차단).
      //   ※ 남의 uid를 건드리지 않음까지의 완전 보장은 규칙만으론 불가(roundups participantUids와 동일 한계) →
      //     영향이 작아(카드 노출 토글) v1 허용, CF 하드닝은 후속 ([[data-integrity-principles]]).
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.audienceUids
        && changedKeysWithin(['respondedUids', 'updatedAt'])
        && selfMembershipToggled('respondedUids');
      // 삭제: author만 (TTL 만료 정리는 후속 Cloud Function).
      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
    }

    // ===== scheduleGroups — 일정 동반자 전파 (Phase B, [[schedule-propagation-spec]]) =====
    //  한 명이 본인 일정을 친구에게 공유(초대) → 수신자 수락 시 본인 schedules에 자기파생(결정적 ID {groupId}_{uid}).
    //  cross-user 쓰기 0 = CF 불필요(roundScoreShares와 동일 패턴). 호스트 없음(initiatorUid=멱등 시드, 권한 아님).
    //  필드: { initiatorUid, initiatorName, sourceScheduleId, course, courseId?, courseLoc?, date, day?, time?,
    //         members, audienceUids:[friendUid], memberUids:[uid], declinedUids:[uid], createdAt, updatedAt }
    //  memberUids=수락자(알림 대상·중복방지), declinedUids=거절자(카드 재노출 방지). 둘 다 create 시 초기화(셀프토글 전제).
    //  쿼리: where('audienceUids','array-contains', 내uid)  (수락/거절 필터는 클라서 member/declined로)
    match /scheduleGroups/{groupId} {
      //  resource == null: 아직 없는 그룹(결정적 ID)의 존재 확인 get 허용 — shareScheduleToFriends가
      //  생성 전 getDoc으로 기존 그룹 여부를 보므로(다른 결정적 ID 컬렉션과 동일 패턴).
      allow read: if isSignedIn() && (
        resource == null
        || request.auth.uid in resource.data.memberUids
        || request.auth.uid in resource.data.audienceUids
      );
      // 생성: 본인이 initiator. memberUids=[본인], declinedUids=[] 로 시작(셀프토글 전제), audience는 리스트.
      allow create: if isSignedIn()
        && request.resource.data.initiatorUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.declinedUids == []
        && request.resource.data.audienceUids is list
        && request.resource.data.course is string
        && request.resource.data.date is string;
      // 초대 추가 — 생성자 또는 수락 멤버 누구나 audienceUids + names(uid→이름 맵, 표시용) 갱신(친구 더 초대).
      //   ★전원 동등 모델 — 동반자가 초대해도 한 그룹에 수렴(별도 그룹 분기 방지). 안 그러면 그 초대자가
      //     만든 별도 그룹으로 쪼개져 원래 일정의 변경알림·내용동기화를 못 받음(사용자 2026-06-20).
      //   declinedUids는 '제거만'(재초대=거절/탈퇴자 un-decline) 허용 — 추가(강제 거절)는 차단.
      //   audience는 줄지 않음(추가만), declined는 늘지 않음(제거만). 둘 다 위조방지 가드.
      allow update: if isSignedIn()
        && (request.auth.uid in resource.data.memberUids
            || request.auth.uid == resource.data.initiatorUid)
        && changedKeysWithin(['audienceUids', 'names', 'declinedUids', 'updatedAt'])
        && request.resource.data.audienceUids.hasAll(resource.data.audienceUids)
        && request.resource.data.declinedUids.hasOnly(resource.data.declinedUids);
      // 공유 일정 내용 수정 — 참여자(생성자 또는 수락 멤버) 누구나(전원 동등 모델). 다른 멤버 자동반영의 소스 ([[schedule-propagation-spec]] v2).
      //   ★initiatorUid도 허용 — 생성자는 자기 일정 수정 권한이 항상 있어야 함(탈퇴 테스트 등으로 memberUids가 비어도).
      //   구장·날짜·좌표는 허용 키에서 제외 = '삭제 후 재생성' 전용으로 잠금(클라 비활성 + 규칙 이중 안전). 라운지 모집은 별도 컬렉션이라 무관.
      allow update: if isSignedIn()
        && (request.auth.uid in resource.data.memberUids
            || request.auth.uid == resource.data.initiatorUid)
        && changedKeysWithin(['time', 'members', 'booker', 'subCourse', 'updatedAt']);
      // 수락 — 수신자(audience)가 memberUids에 '자기 uid'만 토글. 남 변조 완전차단은 규칙만으론 불가(roundScoreShares와 동일 한계, v1 허용).
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.audienceUids
        && changedKeysWithin(['memberUids', 'updatedAt'])
        && selfMembershipToggled('memberUids');
      // 거절 — 수신자(audience)가 declinedUids에 '자기 uid'만 토글.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.audienceUids
        && changedKeysWithin(['declinedUids', 'updatedAt'])
        && selfMembershipToggled('declinedUids');
      // 탈퇴(초대받은 일정 삭제) — 본인을 memberUids에서 빼고 declinedUids에 넣음.
      //   member 제거=알림 중단 / declined 추가=초대 재노출 방지(member에서만 빼면 미응답 취급돼 초대 재노출). 본인 것만.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.memberUids
        && changedKeysWithin(['memberUids', 'declinedUids', 'updatedAt'])
        && !(request.auth.uid in request.resource.data.memberUids)
        && (request.auth.uid in request.resource.data.declinedUids);
      // 삭제: initiator만 (TTL 정리는 후속 CF).
      allow delete: if isSignedIn() && resource.data.initiatorUid == request.auth.uid;
    }

    // ===== mealSuggestions — 라운딩 후 뒤풀이(식사) 장소 결정 ([[afterround-meal-decision]]) =====
    //  총대 한 명(author)이 주변 맛집 골라 제안(결정적 ID meal_{scheduleId}) → 동반자(audience) 👍 동의 → author 결정.
    //  cross-user 데이터 쓰기 0(동의=agreedUids 자기 토글, 푸시만 CF). 그날만 사는 ephemeral(TTL). 채팅 아님.
    //  필드: { authorUid, authorName, scheduleId, course, courseId?, courseLoc?, date,
    //         place:{name,x,y,kakaoId,loc}, note, audienceUids:[friendUid], agreedUids:[uid], decided, decidedBy, ..., expiresAt }
    //  쿼리: where('audienceUids','array-contains', 내uid)
    match /mealSuggestions/{id} {
      allow read: if isSignedIn() && (
        resource == null
        || request.auth.uid == resource.data.authorUid
        || request.auth.uid in resource.data.audienceUids
        // 모집 일정 식사 — audienceUids 스냅샷에 없어도 '현재 모집 참여자'면 읽기 허용(나중에 합류한 사람도 식사 보임).
        || (
          resource.data.get('roundupId', null) != null
          && exists(/databases/$(database)/documents/roundups/$(resource.data.roundupId))
          && request.auth.uid in get(/databases/$(database)/documents/roundups/$(resource.data.roundupId)).data.participantUids
        )
      );
      // 제안 = 결정(단순화 2026-06-18): 먼저 제안한 총대 1명이 식당 고르면 즉시 decided=true(동의 단계 없음).
      //   선착순 1명만 확정은 클라 트랜잭션이 보장(이미 있으면 덮어쓰기 X). 이후 변경은 총대만(아래 update).
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.decided == true
        && request.resource.data.audienceUids is list;
      // 장소 교체·메모 — 정한 사람(author) 또는 단체모집 주최자(hostUid). authorUid 불변 전제.
      //   단체 식사 정책: 식사지정=아무나(선착순 author), 변경=정한 사람 + 주최자 ([[afterround-meal-decision]]).
      allow update: if isSignedIn()
        && request.resource.data.authorUid == resource.data.authorUid
        && (
          resource.data.authorUid == request.auth.uid
          || resource.data.get('hostUid', '') == request.auth.uid
        );
      // 동반자 이탈 — audienceUids에서 '자기 uid'만 제거(일정 삭제로 빠질 때 식사 알림·카드 중단).
      //   정확히 1명(나)만 제거: 추가 없음(hasOnly) + 크기 1 감소 + 나는 이전엔 있고 이후엔 없음. ([[schedule-propagation-spec]])
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.audienceUids
        && changedKeysWithin(['audienceUids', 'updatedAt'])
        && !(request.auth.uid in request.resource.data.audienceUids)
        && request.resource.data.audienceUids.hasOnly(resource.data.audienceUids)
        && resource.data.audienceUids.size() == request.resource.data.audienceUids.size() + 1;
      // 삭제(식사 취소): 작성자 또는 단체모집 주최자(hostUid). 변경 권한과 동일 기준. (TTL 정리는 후속 CF)
      allow delete: if isSignedIn()
        && (resource.data.authorUid == request.auth.uid
            || resource.data.get('hostUid', '') == request.auth.uid);
    }

    // ===== crews — 친구 소수 그룹 공유 앨범 (docs/crew-space-design.md) =====
    //  멤버십 = scheduleGroups 패턴(초대/수락 셀프토글, cross-user 쓰기 0). 전원 동등(운영자 없음).
    //  crews/{id}: { creatorUid, name, memberUids[], audienceUids[], declinedUids[], names{}, notice?, postCount?, ... }
    //  표시이름은 보는 사람 각자 별명으로 화면서 resolve(저장은 authorUid+names). 비속어는 클라(containsProfanity) 사전 차단.
    match /crews/{crewId} {
      // 크루장(creatorUid) / 운영진(creatorUid + adminUids) — 소모임 권한(공지·게시물삭제·프로필변경) 게이트
      function crewMaster() { return resource.data.creatorUid == request.auth.uid; }
      function crewStaff()  { return resource.data.creatorUid == request.auth.uid || (request.auth.uid in resource.data.get('adminUids', [])); }
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.memberUids
        || request.auth.uid in resource.data.audienceUids
      );
      // 생성: 본인이 creator, memberUids==[me], declinedUids==[] (셀프토글 전제)
      allow create: if isSignedIn()
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.declinedUids == []
        && request.resource.data.audienceUids is list
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      // 초대 추가 — 멤버가 audience 추가 + declined 제거(재초대) + 이름맵. audience는 줄지 않음, declined는 늘지 않음.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.memberUids
        && changedKeysWithin(['audienceUids', 'names', 'declinedUids', 'updatedAt'])
        && request.resource.data.audienceUids.hasAll(resource.data.audienceUids)
        && request.resource.data.declinedUids.hasOnly(resource.data.declinedUids);
      // 게시 활동 메타 — 멤버 누구나(글 작성 시 카운트·최근활동 갱신)
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.memberUids
        && changedKeysWithin(['postCount', 'lastPostAt', 'lastPostBy', 'updatedAt']);
      // 공지 — 크루장·운영진
      allow update: if isSignedIn()
        && crewStaff()
        && changedKeysWithin(['notice', 'noticeBy', 'noticeAt', 'updatedAt']);
      // 크루 프로필(이름·색·이미지·성격)·운영진 임명/해제 — 크루장만
      allow update: if isSignedIn()
        && crewMaster()
        && changedKeysWithin(['name', 'themeColor', 'imageUrl', 'description', 'adminUids', 'updatedAt']);
      // 수락 — audience가 memberUids에 '자기 uid'만 토글(+이름)
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.audienceUids
        && changedKeysWithin(['memberUids', 'names', 'updatedAt'])
        && selfMembershipToggled('memberUids');
      // 거절 — audience가 declinedUids 자기 토글
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.audienceUids
        && changedKeysWithin(['declinedUids', 'updatedAt'])
        && selfMembershipToggled('declinedUids');
      // 탈퇴 — 본인 memberUids 빼고 declinedUids 추가(운영진이면 adminUids에서 자기 제거도 허용)
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.memberUids
        && changedKeysWithin(['memberUids', 'declinedUids', 'adminUids', 'updatedAt'])
        && !(request.auth.uid in request.resource.data.memberUids)
        && (request.auth.uid in request.resource.data.declinedUids)
        && !(request.auth.uid in request.resource.data.get('adminUids', []));
      // 크루장 탈퇴 승계 — 크루장이 운영진 중 한 명에게 넘기며 본인 탈퇴(새 크루장은 기존 운영진이어야 = 임의 승계 차단)
      allow update: if isSignedIn()
        && crewMaster()
        && changedKeysWithin(['memberUids', 'declinedUids', 'creatorUid', 'adminUids', 'updatedAt'])
        && !(request.auth.uid in request.resource.data.memberUids)
        && (request.resource.data.creatorUid in resource.data.adminUids);
      // 삭제: 크루장만 (빈 크루 정리는 후속)
      allow delete: if isSignedIn() && resource.data.creatorUid == request.auth.uid;

      // 게시물 — 크루 멤버만(부모 crew get). mealSuggestions의 부모 get 선례.
      match /posts/{postId} {
        function crewMember() {
          return request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberUids;
        }
        allow read:   if isSignedIn() && crewMember();
        allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid && crewMember();
        // 댓글수(commentCount) 증가는 멤버 누구나 — 본문·작성자 불변
        allow update: if isSignedIn() && crewMember() && changedKeysWithin(['commentCount']);
        // 본문·미디어 수정 — 작성자 본인만(작성자 불변)
        allow update: if isSignedIn() && resource.data.authorUid == request.auth.uid && crewMember()
          && changedKeysWithin(['text', 'media', 'editedAt']);
        // 삭제 — 작성자 본인 OR 크루장·운영진(부적절 글 정리)
        allow delete: if isSignedIn() && (
          resource.data.authorUid == request.auth.uid
          || get(/databases/$(database)/documents/crews/$(crewId)).data.creatorUid == request.auth.uid
          || (request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.get('adminUids', []))
        );

        match /comments/{commentId} {
          function crewMemberC() {
            return request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberUids;
          }
          allow read:   if isSignedIn() && crewMemberC();
          allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid && crewMemberC()
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 300;
          // 본문 수정 — 작성자 본인만(작성자·parentId 불변)
          allow update: if isSignedIn() && resource.data.authorUid == request.auth.uid && crewMemberC()
            && changedKeysWithin(['body', 'editedAt'])
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 300;
          // 삭제 — 작성자 본인 OR 크루장·운영진(부적절 댓글 정리)
          allow delete: if isSignedIn() && (
            resource.data.authorUid == request.auth.uid
            || get(/databases/$(database)/documents/crews/$(crewId)).data.creatorUid == request.auth.uid
            || (request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.get('adminUids', []))
          );
        }
      }
    }

    // ===== friendships — 친구 관계. 문서 ID = pairId(uidA, uidB) =====
    // { users:[uidA,uidB], requesterUid, recipientUid, status:'pending'|'accepted' }
    match /friendships/{fid} {
      //  resource == null: 아직 없는 친구문서(결정적 pairId)의 존재 확인 get 허용 —
      //  첫 친구 신청·areFriends 조회 전 getDoc이 막히던 버그 수정. 실재 문서는 당사자만 read.
      //  requesterUid/recipientUid 절: loadReceivedRequests·loadSentRequests가
      //  users 배열이 아니라 recipientUid·requesterUid로 쿼리하므로, 그 절이 없으면
      //  쿼리가 규칙과 안 맞아 "insufficient permissions"로 막힘. 두 필드는 항상
      //  users 배열의 당사자라 추가 노출 없음.
      allow read: if isSignedIn()
        && (resource == null
            || request.auth.uid in resource.data.users
            || request.auth.uid == resource.data.requesterUid
            || request.auth.uid == resource.data.recipientUid);

      // 신청: 본인이 requester, status는 pending, users는 정확히 두 당사자,
      //       문서 ID는 정규 pairId 여야 함 (areFriends가 ID를 계산해 조회하므로)
      allow create: if isSignedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.users.hasOnly([request.resource.data.requesterUid, request.resource.data.recipientUid])
        && request.resource.data.users.hasAll([request.resource.data.requesterUid, request.resource.data.recipientUid])
        && fid == pairId(request.resource.data.requesterUid, request.resource.data.recipientUid);

      // 수락: 수신자만, status를 pending → accepted 로만
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.recipientUid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && changedKeysWithin(['status', 'updatedAt']);

      // 삭제: 양쪽 당사자 누구나 (신청 취소·거절·친구 끊기)
      allow delete: if isSignedIn() && request.auth.uid in resource.data.users;
    }

    // ===== roundups — 라운딩 모집글. 공개범위 2단계: 'all' | 'friends' =====
    // 클라이언트 쿼리 규칙:
    //   · 전체 모집 : where('scope','==','all')
    //   · 친구 모집 : where('scope','==','friends').where('authorUid','==', 친구uid)
    //   · 내 모집   : where('authorUid','==', 내uid)
    match /roundups/{postId} {
      allow read: if isSignedIn() && (
        resource.data.scope == 'all'
        || resource.data.authorUid == request.auth.uid
        || (resource.data.scope == 'friends'
            && areFriends(request.auth.uid, resource.data.authorUid))
        // 친구지정(select): 작성 시점에 해석된 audienceUids 멤버십만 검사 ([[roundup-visibility-design]] 2026-06-01 정정).
        //   include·exclude 둘 다 audienceUids로 통일 → array-contains 쿼리와 정확히 일치(규칙=쿼리, 거부 방지).
        //   areFriends는 다중 author array-contains 쿼리에서 또 쿼리거부를 유발해 제외. audienceUids가 작성자 친구로 한정돼 안전.
        || (resource.data.scope == 'select'
            && request.auth.uid in resource.data.audienceUids)
        // 참여자는 자기가 든 모집을 항상 read 가능 — 친구관계가 끊겨도(탈퇴 cascade의 친구삭제 등)
        //   participantUids array-contains 쿼리가 통째 거부되어 참여자 제거가 실패하던 문제 방지.
        //   본인이 이미 참여 중인 모집이라 정보 노출 위험 없음.
        || request.auth.uid in resource.data.participantUids
      );
      // 전체공개(all) 생성 비활성화 — 2026-06-01 ([[roundup-public-disabled]]). UI 게이팅에 더해 방어적 차단.
      //   친구공개(friends)·친구지정(select)만 허용. 전체공개 부활 시 'all' 추가.
      //   (기존 all 문서 read는 위 read 규칙에 그대로 두되, 출시 전 테스트 시딩 삭제로 잔존 없음)
      //   select는 audienceUids·selectMode·selectedUids 배열/값 형식만 검증 ([[roundup-visibility-design]]).
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.scope in ['friends', 'select']
        && request.resource.data.participantUids is list
        && request.resource.data.waitlistUids is list
        && (
          request.resource.data.scope != 'select'
          || (
            request.resource.data.selectMode in ['include', 'exclude']
            && request.resource.data.selectedUids is list
            && request.resource.data.audienceUids is list
          )
        );

      // 주최자: 전체 수정 / 참여자: 참여·대기 배열만, 본인 포함 여부만 토글
      //   ※ "남의 uid를 건드리지 않음"까지의 완전한 보장은 규칙만으론 불가 —
      //     정확한 정원 처리는 Cloud Function(트랜잭션)으로 이관 권장
      //  참여자는 closed를 false로만 바꿀 수 있음(결원 발생 시 확정 해제). true로 확정은 주최자만.
      //  ([[roundup-penalty-policy]] §4, 2026-05-30) — 대기신청 등 closed 유지 동작은 그대로 통과.
      allow update: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid
        || (
          resource.data.authorUid != request.auth.uid
          // anonymousUids: 익명 참여 토글(자기 uid만 add/remove) — 표시 마스킹용. selfMembershipToggled로 self-only는
          //   participantUids/waitlistUids 토글에 의존(남의 익명여부 조작 완전차단은 규칙만으론 불가 → CF 이관 권장 [[data-integrity-principles]]).
          && changedKeysWithin(['participantUids', 'waitlistUids', 'joined', 'teamJoined', 'closed', 'anonymousUids', 'updatedAt'])
          && (selfMembershipToggled('participantUids') || selfMembershipToggled('waitlistUids'))
          && (resource.data.closed == request.resource.data.closed || request.resource.data.closed == false)
        )
        || (
          // 좋아요(응원) — 작성자 외 읽기권한자가 likedBy에 본인 uid만 토글 (모두 공개, [[roundup-friend-redesign]]).
          //   골퍼코멘트 좋아요와 동일 패턴. likedBy 외 필드 불변. 카운트=likedBy.length(별도 likes 필드 없음).
          resource.data.authorUid != request.auth.uid
          && changedKeysWithin(['likedBy'])
          && selfMembershipToggled('likedBy')
        )
      );
      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;

      // ===== 댓글 서브컬렉션 — roundups/{postId}/comments/{commentId} ([[roundup-comments-policy]]) =====
      //  기본 검증(2026-05-30): create=작성자 본인 / delete=본인만 / 고정=pinned·pinnedAt만 변경.
      //  "참여 확정자만 작성·열람"은 클라이언트 UI에서 차단(부모 roundup get 비용 회피).
      //  read는 로그인한 누구나 — 모집글 read 권한이 이미 scope로 통제되므로 댓글 본문 유출 위험 낮음.
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 300;
        // 본인 삭제만 (주최자도 타인 댓글 삭제 불가 — 정책 §1)
        allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
        // 고정 토글 — pinned·pinnedAt만 변경 (주최자 제한은 클라 UI. 본문 변조는 차단)
        allow update: if isSignedIn()
          && changedKeysWithin(['pinned', 'pinnedAt']);
      }
    }

    // ===== roundupApplications — 모집 참여 신청 (전체공개 모집 전용) =====
    //  Doc ID = {roundupId}_{applicantUid} (deterministic, 중복 신청 차단)
    //  status: 'pending' | 'accepted' | 'rejected' | 'cancelled'
    //  - 친구공개·친구지정 모집은 즉시 확정이라 이 컬렉션 사용 X
    //  - 분쟁·매너평가·노쇼 신고 참조 자료로 보존 ([[data-retention]] 보관 정책에 따름)
    //  클라이언트 쿼리 규칙:
    //   · 내 신청 목록 : where('applicantUid','==', 내uid).where('status','==', 'pending')
    //   · 주최자 화면  : where('roundupId','==', postId).where('status','==', 'pending')
    match /roundupApplications/{appId} {
      //  resource == null: 아직 없는 신청서(결정적 ID)의 존재 확인 get 허용 —
      //  신청 전 getDoc이 막히던 버그 수정. 실재하는 문서는 본인(신청자/주최자)만 read.
      allow read: if isSignedIn() && (
        resource == null
        || resource.data.applicantUid == request.auth.uid
        || resource.data.authorUid == request.auth.uid
      );

      // 신청자가 본인 이름으로 doc ID 정합성 맞춰 생성. 본인 모집엔 신청 불가.
      allow create: if isSignedIn()
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.authorUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && appId == request.resource.data.roundupId + '_' + request.resource.data.applicantUid;

      // update 3분기: 주최자 결정 / 신청자 취소 / 신청자 재신청
      // 불변 필드(roundupId·applicantUid·authorUid·createdAt) 변조 차단은 changedKeysWithin이 보장
      allow update: if isSignedIn() && (
        // (1) 주최자: pending → accepted/rejected
        (
          resource.data.authorUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'rejected']
          && changedKeysWithin(['status', 'updatedAt'])
        )
        // (2) 신청자: pending → cancelled
        || (
          resource.data.applicantUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && changedKeysWithin(['status', 'updatedAt'])
        )
        // (3) 신청자: rejected/cancelled → pending (재신청)
        || (
          resource.data.applicantUid == request.auth.uid
          && resource.data.status in ['rejected', 'cancelled']
          && request.resource.data.status == 'pending'
          && changedKeysWithin(['status', 'updatedAt'])
        )
      );

      // delete — 분쟁·이력 보존 정책상 클라이언트 삭제 불가.
      // 보관기간 만료 시 Cloud Function 정리 (Phase 2 후속).
    }

    // ===== roundupNotifications — 모집 알림 =====
    //   ※ create를 클라이언트에 열어두면 알림 스팸이 가능 —
    //     운영 단계에선 Cloud Function 생성으로 이관 권장
    match /roundupNotifications/{notiId} {
      allow read: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.recipientUid != request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid
        && changedKeysWithin(['read']);          // 읽음 처리만
      allow delete: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid;
    }

    // ===== courseComments — 골퍼 코멘트 (이미 운영 중) =====
    match /courseComments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.likes == 0;
      // 작성자: 본인 코멘트 수정 / 그 외: 좋아요 토글만
      //   likes는 ±1로만 변동 — 본인을 likedBy에 추가하면 +1, 제거하면 -1
      //   (시딩 코멘트는 likes>0·likedBy 빈 배열이라 길이 일치 검증은 못 씀)
      allow update: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid
        || (
          changedKeysWithin(['likedBy', 'likes'])
          && selfMembershipToggled('likedBy')
          && request.resource.data.likes == resource.data.likes
               + ((request.auth.uid in request.resource.data.likedBy) ? 1 : -1)
        )
      );
      allow delete: if isSignedIn()
        && resource.data.authorUid == request.auth.uid;
    }

    // ===== courseRatings — 코스 평점 ([[project_course_rating]]) =====
    //  Doc ID = {courseId}_{uid} (deterministic, 1인 1코스 1평가). mgmt/pace/value 각 1~5 별점.
    match /courseRatings/{ratingId} {
      function validScores() {
        return request.resource.data.mgmt is int && request.resource.data.mgmt >= 1 && request.resource.data.mgmt <= 5
          && request.resource.data.pace is int && request.resource.data.pace >= 1 && request.resource.data.pace <= 5
          && request.resource.data.value is int && request.resource.data.value >= 1 && request.resource.data.value <= 5;
      }
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && ratingId == request.resource.data.courseId + '_' + request.auth.uid
        && validScores();
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && validScores();
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ===== mannerEvaluations — 매너 평가 ([[manner-evaluation-policy]]) =====
    //  Doc ID = {roundupId}_{evaluatorUid}_{targetUid} (deterministic, 1인 1대상 1모집 1회)
    //  rating: 'good' | 'bad' (neutral=무평가는 doc 자체가 없음)
    //  익명 일괄 집계는 Cloud Functions가 처리 (48h 윈도우 후).
    //
    //  보안: 평가자 본인 read·create만. update/delete 불가 (수정 불가).
    //  대상자(target)는 자기 평가를 직접 못 읽음 — Cloud Functions가 집계 후 mannerScore에만 적용.
    match /mannerEvaluations/{evalId} {
      //  resource == null: 아직 없는 평가(결정적 ID)의 중복 확인 get 허용. 실재 문서는 평가자 본인만.
      allow read: if isSignedIn()
        && (resource == null || resource.data.evaluatorUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.evaluatorUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.roundupId is string
        && request.resource.data.rating in ['good', 'bad']
        && evalId == request.resource.data.roundupId + '_' + request.resource.data.evaluatorUid + '_' + request.resource.data.targetUid;
      allow update, delete: if false;  // 수정 불가, 보관 12개월은 Cloud Functions
    }

    // ===== noshowReports — 노쇼 신고 ([[noshow-report-system]]) =====
    //  7일 유예 → 48h 소명 → 48h 검토 → 매너 -20 + 60일/90일 정지.
    //  status: pending_grace_period | cancelled_by_reporter | explanation_required
    //          | explained | confirmed_noshow | confirmed_false_report | inconclusive
    //
    //  보안:
    //   - 신고자: 본인 신고 read·create + pending_grace_period → cancelled_by_reporter
    //   - 피신고자: 본인 대상 신고 read + explanation_required → explained (소명 제출만)
    //   - 그 외 상태 전환·정지 적용은 Cloud Functions만
    match /noshowReports/{reportId} {
      allow read: if isSignedIn() && (
        resource.data.reporterUid == request.auth.uid
        || resource.data.reportedUid == request.auth.uid
      );

      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid != request.auth.uid
        && request.resource.data.roundupId is string
        && request.resource.data.reason is string
        && request.resource.data.status == 'pending_grace_period';

      // update 2분기: 신고자 자율 취소 / 피신고자 소명 제출
      allow update: if isSignedIn() && (
        // (1) 신고자: pending_grace_period → cancelled_by_reporter
        (
          resource.data.reporterUid == request.auth.uid
          && resource.data.status == 'pending_grace_period'
          && request.resource.data.status == 'cancelled_by_reporter'
          && changedKeysWithin(['status', 'updatedAt'])
        )
        // (2) 피신고자: explanation_required → explained (소명 텍스트·자료 동봉)
        || (
          resource.data.reportedUid == request.auth.uid
          && resource.data.status == 'explanation_required'
          && request.resource.data.status == 'explained'
          && changedKeysWithin(['status', 'explanation', 'updatedAt'])
        )
      );

      allow delete: if false;  // 보관 기간 만료는 Cloud Functions ([[data-retention]])
    }

    // ===== content_reports — 게시물 신고 ([[content-report-policy]]) =====
    //  Doc ID = {targetType}_{targetId}_{reporterUid} (deterministic, 1인 1회 제한)
    //  targetType: 'courseComment' | 'roundup' | 'roundupComment' | 'friendDiary'
    //  status: 'pending' | 'confirmed' | 'rejected'
    //  보안: 신고자 본인이 자기 신고 read·create. 변조·삭제는 Cloud Functions만.
    //  사용자 신고(reports)와 분리 — 한도 X, 양방향 차단 X, 부담 없는 신고.
    match /content_reports/{reportId} {
      //  resource == null: 아직 없는 신고(결정적 ID)의 중복 확인 get 허용. 실재 문서는 신고자 본인만.
      allow read: if isSignedIn()
        && (resource == null || resource.data.reporterUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetType in ['courseComment', 'roundup', 'roundupComment', 'friendDiary']
        && request.resource.data.targetId is string
        && request.resource.data.reason in ['ad_spam', 'inappropriate']
        && request.resource.data.status == 'pending'
        && reportId == request.resource.data.targetType + '_' + request.resource.data.targetId + '_' + request.resource.data.reporterUid;
      allow update, delete: if false;
    }

    // ===== reports — 사용자 신고 ([[report-block-policy]] E안) =====
    //  Doc 자동 ID. 검토 진행은 디어골프 팀(관리자) 수동·Cloud Functions 처리.
    //  status: 'pending' | 'reviewing' | 'confirmed' | 'rejected'
    //  보안: 신고자 본인만 자기 신고 조회 가능 (검토 결과 통보). 작성 후 변조·삭제 불가.
    //  클라이언트 쿼리: where('reporterUid','==', 내uid).orderBy('createdAt','desc')
    match /reports/{reportId} {
      allow read: if isSignedIn() && resource.data.reporterUid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.evidence is string
        && request.resource.data.status == 'pending';
      allow update, delete: if false;  // 검토·해결은 관리자/Cloud Functions만
    }

    // ===== locationAccessLogs — 위치정보 이용·제공사실 확인자료 =====
    //  위치정보법 제16조 제2항 — 자동 기록·보존 의무. 보존기간 6개월 (업계 관행).
    //  필드: ownerUid, providerName, purpose, accessedAt, method
    //  보안: 본인만 read (열람권). 클라이언트 작성 허용(사용 시점 기록).
    //        삭제는 Cloud Functions (6개월 만료 자동 정리) 또는 본인 철회 시.
    match /locationAccessLogs/{logId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.providerName is string
        && request.resource.data.purpose is string;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ===== banned_users — 정지 이력 보존 (재가입 차단용) =====
    // 문서 ID = 카카오 OIDC sub (kakaoId). 콘텐츠는 탈퇴 시 전부 삭제되지만
    // 정지 사실과 식별자만 별도 보존 ([[account-deletion]] A안).
    //
    // 보안: 카카오 로그인 콜백에서 본인 sub 매칭 차단용으로 read 필요.
    // write는 정지된 본인의 탈퇴 시점에 한정 — Phase 5 Cloud Functions로 이관 권장.
    //   (현재 임시 클라이언트 작성 — 위조 위험은 카카오 sub를 다른 사람의 것 알기 어려움으로 완화)
    match /banned_users/{kakaoSub} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.kakaoSub == kakaoSub
        && request.resource.data.reason is string;
      allow update, delete: if false;  // 변조 금지. 만료/해제는 Cloud Functions가 처리 ([[age-policy]] §3)
    }

    // ===== top100Courses — 100대 코스 (시딩 완료, 읽기 전용) =====
    match /top100Courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if false;     // 콘솔/관리자 스크립트로만 수정
    }

    // ===== golfCourses — 전국 골프장 마스터 (공공데이터+카카오 매칭, 읽기 전용) =====
    // 시딩: scripts/seedGolfCourses.mjs. 시딩 중에만 write 를 임시 true 로 열고, 끝나면 false 로 되돌려 배포.
    match /golfCourses/{courseId} {
      allow read: if isSignedIn();
      allow write: if false;     // 콘솔/관리자 스크립트로만 수정
    }

    // ===== conversations — 친구 1:1 DM ([[dm-design]]) =====
    //   convId = pairId(두 uid). 양쪽 참여자만 read/write. 메시지는 messages 서브컬렉션.
    //   새 방·메시지 생성 시 areFriends 강제(낯선 사람 DM 차단). 기존 대화 read는 멤버십만(끊겨도 열람).
    match /conversations/{convId} {
      // 새 문서 기준 상대 uid (participantUids는 정렬된 2개)
      function otherUidNew() {
        return request.resource.data.participantUids[0] == request.auth.uid
          ? request.resource.data.participantUids[1]
          : request.resource.data.participantUids[0];
      }
      //  resource == null: 아직 없는 대화방(결정적 pairId)의 존재 확인 get 허용 — 대화 없는 친구 첫 진입 시
      //  ensureConversation의 getDoc이 막혀 convId 설정 실패→"불러오는 중" 무한 로딩되던 버그 수정(2026-06-14).
      //  다른 결정적 ID 컬렉션(friendships·roundupApplications 등)과 동일 패턴. 실재 문서는 참여자만 read.
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participantUids);
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.participantUids.size() == 2
        && convId == pairId(request.resource.data.participantUids[0], request.resource.data.participantUids[1])
        && areFriends(request.auth.uid, otherUidNew());
      // 현재 문서 기준 상대 uid
      function otherUidCur() {
        return resource.data.participantUids[0] == request.auth.uid
          ? resource.data.participantUids[1]
          : resource.data.participantUids[0];
      }
      // 메타 갱신만 — 참여자 변경·방 삭제 불가.
      //   친구+비차단일 때만(sendMessage의 lastMessage 갱신이 메시지 create보다 먼저라, 여기 안 막으면
      //   차단 후에도 목록 미리보기가 갱신되는 유령 lastMessage 발생) ([[dm-design]] 차단 모순 수정 2026-06-10)
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantUids
        && changedKeysWithin(['lastMessage', 'lastSenderUid', 'lastAt', 'updatedAt'])
        && areFriends(request.auth.uid, otherUidCur())
        && !dmBlockedBetween(request.auth.uid, otherUidCur());
      // 읽음 표시 — 본인 lastRead 키만 갱신. 멤버십만 요구(친구해지·차단 무관하게 '읽음' 처리는 무해).
      //   reactions와 동일 패턴: lastRead 맵의 자기 uid 키만 변경 허용(상대 읽음시각 위조 차단). ([[dm-design]])
      //   + unread: 본인 안읽음 카운트 리셋(0)도 함께 허용(CF가 +1, 읽으면 본인 키만 0). 둘 다 자기 uid 키만.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantUids
        && changedKeysWithin(['lastRead', 'unread'])
        && request.resource.data.get('lastRead', {}).diff(resource.data.get('lastRead', {})).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.get('unread', {}).diff(resource.data.get('unread', {})).affectedKeys().hasOnly([request.auth.uid]);
      // 입력 중(타이핑) 표시 — 본인 typing 키만 갱신/해제. 멤버십만(상태 표시라 무해), lastRead와 동일 위조방지.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantUids
        && changedKeysWithin(['typing'])
        && request.resource.data.get('typing', {}).diff(resource.data.get('typing', {})).affectedKeys().hasOnly([request.auth.uid]);
      // '나만 목록에서 지우기' — 본인 clearedAt 키만 갱신(상대 영향 0). 멤버십만(읽음·타이핑과 동일, 위조방지=자기 키만).
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantUids
        && changedKeysWithin(['clearedAt'])
        && request.resource.data.get('clearedAt', {}).diff(resource.data.get('clearedAt', {})).affectedKeys().hasOnly([request.auth.uid]);
      allow delete: if false;

      match /messages/{msgId} {
        function members() {
          return get(/databases/$(database)/documents/conversations/$(convId)).data.participantUids;
        }
        function otherMember() {
          return members()[0] == request.auth.uid ? members()[1] : members()[0];
        }
        allow read: if isSignedIn() && request.auth.uid in members();
        // 답장(인용) 검증 — replyTo가 있으면 스냅샷(body·senderUid)이 같은 방의 '실제 원본 메시지'와
        //   일치해야 함 = 인용 위조(안 한 말 조작) 차단. 원본 삭제 후엔 새 답장 불가(기존 답장은 유지).
        function replyToValid() {
          return !('replyTo' in request.resource.data)
            || (request.resource.data.replyTo is map
                && request.resource.data.replyTo.keys().hasOnly(['msgId', 'body', 'senderUid'])
                && request.resource.data.replyTo.msgId is string
                && get(/databases/$(database)/documents/conversations/$(convId)/messages/$(request.resource.data.replyTo.msgId)).data.body == request.resource.data.replyTo.body
                && get(/databases/$(database)/documents/conversations/$(convId)/messages/$(request.resource.data.replyTo.msgId)).data.senderUid == request.resource.data.replyTo.senderUid);
        }
        // 전송 = 친구 + 양방향 비차단일 때만 — 차단했는데 DM이 오는 모순 차단(친구 해지·차단 모두 커버).
        //   기존 메시지 read는 유지(카톡식 — 대화 이력은 보임).
        // body(텍스트) 또는 imageUrl(이미지 메시지) 중 하나는 있어야 함. 이미지 메시지는 body='' 허용([[dm-design]] 사진공유).
        allow create: if isSignedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in members()
          && areFriends(request.auth.uid, otherMember())
          && !dmBlockedBetween(request.auth.uid, otherMember())
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 2000
          && (request.resource.data.body.size() > 0
              || (request.resource.data.get('imageUrl', '') is string && request.resource.data.get('imageUrl', '').size() > 0)
              || (request.resource.data.get('imageUrls', []) is list && request.resource.data.get('imageUrls', []).size() > 0)
              || (request.resource.data.get('videoUrl', '') is string && request.resource.data.get('videoUrl', '').size() > 0))
          && replyToValid();
        // 수정은 공감(reactions)만 — 본문·발신자 불변(신고 증거 보전, 몰래 고치기 차단).
        //   참여자가 reactions 맵의 '자기 uid 키'만 추가/변경/제거 가능. 값=짧은 이모지 문자열.
        //   전송(create)과 동일하게 친구+양방향 비차단일 때만(차단 후 상호작용 모순 차단).
        allow update: if isSignedIn()
          && request.auth.uid in members()
          && areFriends(request.auth.uid, otherMember())
          && !dmBlockedBetween(request.auth.uid, otherMember())
          && changedKeysWithin(['reactions'])
          && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.get('reactions', {}))
              || (request.resource.data.reactions[request.auth.uid] is string
                  && request.resource.data.reactions[request.auth.uid].size() <= 16));
        allow delete: if isSignedIn() && resource.data.senderUid == request.auth.uid;  // 본인 메시지만
      }
    }

    // 위에 없는 모든 컬렉션은 기본 거부됨 (schedules·userCourses 등은 현재 로컬 보관)
  }
}
