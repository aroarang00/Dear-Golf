rules_version = '2';

// =============================================================
// Dear Golf — Firestore 보안 규칙
//  - 앱은 익명 인증(signInAnonymously) 기반 — request.auth는 익명 유저도 채워짐
//  - 원칙: 본인 데이터만 쓰기(ownerUid/authorUid == request.auth.uid 강제)
//  - 명시되지 않은 모든 경로는 기본 거부(default deny)
//  - 규칙은 "필터"가 아님 — 목록 쿼리는 클라이언트가 ownerUid 등으로
//    직접 필터해야 통과함 (하단 컬렉션별 주석 참고)
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 공통 헬퍼 =====
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // 두 uid로 친구 문서 ID 생성 — 항상 (작은uid)_(큰uid) 순서로 정렬
    function pairId(a, b) {
      return a < b ? (a + '_' + b) : (b + '_' + a);
    }
    // a와 b가 '수락된' 친구 사이인지 (friendships 문서 조회)
    function areFriends(a, b) {
      return exists(/databases/$(database)/documents/friendships/$(pairId(a, b)))
        && get(/databases/$(database)/documents/friendships/$(pairId(a, b))).data.status == 'accepted';
    }
    // update 시 변경된 필드가 허용 목록 안에만 있는지
    function changedKeysWithin(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }
    // 호출자가 배열에서 '자기 자신'의 포함 여부만 토글했는지 (가입/탈퇴·좋아요)
    function selfMembershipToggled(field) {
      return (request.auth.uid in resource.data[field])
          != (request.auth.uid in request.resource.data[field]);
    }

    // ===== users — 골퍼 프로필 (명함). MY 탭 = 친구 프로필 = 같은 스키마 =====
    // 읽기: 로그인한 누구나 (친구 검색·친구 프로필·모집 작성자 표시에 필요)
    //   ※ 민감 정보(전화번호 등)는 users 문서에 직접 저장하지 말 것
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      allow update: if isOwner(uid) && request.resource.data.uid == uid;
      allow delete: if isOwner(uid);
    }

    // ===== schedules — 라운딩 예정 일정 (본인만 read/write) =====
    // 클라이언트 쿼리: where('ownerUid','==', 내uid).orderBy('date','asc')
    // dDay·weather 등 파생값은 클라이언트 계산이라 저장 X.
    match /schedules/{scheduleId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;   // ownerUid 변조 금지
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ===== rounds — 라운딩 기록 (구 diaries + 친구 feed 통합) =====
    // 클라이언트 쿼리 규칙 (규칙은 필터가 아님):
    //   · 내 기록      : where('ownerUid','==', 내uid)
    //   · 친구 feed    : where('ownerUid','==', 친구uid).where('visibility','==','friends')
    // 위 형태로 필터해야 list 쿼리가 통과함.
    match /rounds/{roundId} {
      allow read: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid
        || (resource.data.visibility == 'friends'
            && areFriends(request.auth.uid, resource.data.ownerUid))
      );
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.visibility in ['friends', 'private'];
      allow update: if isSignedIn() && (
        // 본인 — 전체 수정 (ownerUid 변조 금지)
        (resource.data.ownerUid == request.auth.uid
         && request.resource.data.ownerUid == request.auth.uid)
        // 친구 — 친구공개 라운드의 좋아요(likes)에서 자기 uid만 토글 ([[friend-feed-design]])
        || (resource.data.visibility == 'friends'
            && areFriends(request.auth.uid, resource.data.ownerUid)
            && changedKeysWithin(['likes', 'updatedAt'])
            && selfMembershipToggled('likes'))
      );
      allow delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // ===== friendships — 친구 관계. 문서 ID = pairId(uidA, uidB) =====
    // { users:[uidA,uidB], requesterUid, recipientUid, status:'pending'|'accepted' }
    match /friendships/{fid} {
      //  resource == null: 아직 없는 친구문서(결정적 pairId)의 존재 확인 get 허용 —
      //  첫 친구 신청·areFriends 조회 전 getDoc이 막히던 버그 수정. 실재 문서는 당사자만 read.
      //  requesterUid/recipientUid 절: loadReceivedRequests·loadSentRequests가
      //  users 배열이 아니라 recipientUid·requesterUid로 쿼리하므로, 그 절이 없으면
      //  쿼리가 규칙과 안 맞아 "insufficient permissions"로 막힘. 두 필드는 항상
      //  users 배열의 당사자라 추가 노출 없음.
      allow read: if isSignedIn()
        && (resource == null
            || request.auth.uid in resource.data.users
            || request.auth.uid == resource.data.requesterUid
            || request.auth.uid == resource.data.recipientUid);

      // 신청: 본인이 requester, status는 pending, users는 정확히 두 당사자,
      //       문서 ID는 정규 pairId 여야 함 (areFriends가 ID를 계산해 조회하므로)
      allow create: if isSignedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.users.hasOnly([request.resource.data.requesterUid, request.resource.data.recipientUid])
        && request.resource.data.users.hasAll([request.resource.data.requesterUid, request.resource.data.recipientUid])
        && fid == pairId(request.resource.data.requesterUid, request.resource.data.recipientUid);

      // 수락: 수신자만, status를 pending → accepted 로만
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.recipientUid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && changedKeysWithin(['status', 'updatedAt']);

      // 삭제: 양쪽 당사자 누구나 (신청 취소·거절·친구 끊기)
      allow delete: if isSignedIn() && request.auth.uid in resource.data.users;
    }

    // ===== roundups — 라운딩 모집글. 공개범위 2단계: 'all' | 'friends' =====
    // 클라이언트 쿼리 규칙:
    //   · 전체 모집 : where('scope','==','all')
    //   · 친구 모집 : where('scope','==','friends').where('authorUid','==', 친구uid)
    //   · 내 모집   : where('authorUid','==', 내uid)
    match /roundups/{postId} {
      allow read: if isSignedIn() && (
        resource.data.scope == 'all'
        || resource.data.authorUid == request.auth.uid
        || (resource.data.scope == 'friends'
            && areFriends(request.auth.uid, resource.data.authorUid))
        // 친구지정(select): 작성 시점에 해석된 audienceUids 멤버십만 검사 ([[roundup-visibility-design]] 2026-06-01 정정).
        //   include·exclude 둘 다 audienceUids로 통일 → array-contains 쿼리와 정확히 일치(규칙=쿼리, 거부 방지).
        //   areFriends는 다중 author array-contains 쿼리에서 또 쿼리거부를 유발해 제외. audienceUids가 작성자 친구로 한정돼 안전.
        || (resource.data.scope == 'select'
            && request.auth.uid in resource.data.audienceUids)
      );
      // 전체공개(all) 생성 비활성화 — 2026-06-01 ([[roundup-public-disabled]]). UI 게이팅에 더해 방어적 차단.
      //   친구공개(friends)·친구지정(select)만 허용. 전체공개 부활 시 'all' 추가.
      //   (기존 all 문서 read는 위 read 규칙에 그대로 두되, 출시 전 테스트 시딩 삭제로 잔존 없음)
      //   select는 audienceUids·selectMode·selectedUids 배열/값 형식만 검증 ([[roundup-visibility-design]]).
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.scope in ['friends', 'select']
        && request.resource.data.participantUids is list
        && request.resource.data.waitlistUids is list
        && (
          request.resource.data.scope != 'select'
          || (
            request.resource.data.selectMode in ['include', 'exclude']
            && request.resource.data.selectedUids is list
            && request.resource.data.audienceUids is list
          )
        );

      // 주최자: 전체 수정 / 참여자: 참여·대기 배열만, 본인 포함 여부만 토글
      //   ※ "남의 uid를 건드리지 않음"까지의 완전한 보장은 규칙만으론 불가 —
      //     정확한 정원 처리는 Cloud Function(트랜잭션)으로 이관 권장
      //  참여자는 closed를 false로만 바꿀 수 있음(결원 발생 시 확정 해제). true로 확정은 주최자만.
      //  ([[roundup-penalty-policy]] §4, 2026-05-30) — 대기신청 등 closed 유지 동작은 그대로 통과.
      allow update: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid
        || (
          resource.data.authorUid != request.auth.uid
          && changedKeysWithin(['participantUids', 'waitlistUids', 'joined', 'teamJoined', 'closed', 'updatedAt'])
          && (selfMembershipToggled('participantUids') || selfMembershipToggled('waitlistUids'))
          && (resource.data.closed == request.resource.data.closed || request.resource.data.closed == false)
        )
        || (
          // 좋아요(응원) — 작성자 외 읽기권한자가 likedBy에 본인 uid만 토글 (모두 공개, [[roundup-friend-redesign]]).
          //   골퍼코멘트 좋아요와 동일 패턴. likedBy 외 필드 불변. 카운트=likedBy.length(별도 likes 필드 없음).
          resource.data.authorUid != request.auth.uid
          && changedKeysWithin(['likedBy'])
          && selfMembershipToggled('likedBy')
        )
      );
      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;

      // ===== 댓글 서브컬렉션 — roundups/{postId}/comments/{commentId} ([[roundup-comments-policy]]) =====
      //  기본 검증(2026-05-30): create=작성자 본인 / delete=본인만 / 고정=pinned·pinnedAt만 변경.
      //  "참여 확정자만 작성·열람"은 클라이언트 UI에서 차단(부모 roundup get 비용 회피).
      //  read는 로그인한 누구나 — 모집글 read 권한이 이미 scope로 통제되므로 댓글 본문 유출 위험 낮음.
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 300;
        // 본인 삭제만 (주최자도 타인 댓글 삭제 불가 — 정책 §1)
        allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
        // 고정 토글 — pinned·pinnedAt만 변경 (주최자 제한은 클라 UI. 본문 변조는 차단)
        allow update: if isSignedIn()
          && changedKeysWithin(['pinned', 'pinnedAt']);
      }
    }

    // ===== roundupApplications — 모집 참여 신청 (전체공개 모집 전용) =====
    //  Doc ID = {roundupId}_{applicantUid} (deterministic, 중복 신청 차단)
    //  status: 'pending' | 'accepted' | 'rejected' | 'cancelled'
    //  - 친구공개·친구지정 모집은 즉시 확정이라 이 컬렉션 사용 X
    //  - 분쟁·매너평가·노쇼 신고 참조 자료로 보존 ([[data-retention]] 보관 정책에 따름)
    //  클라이언트 쿼리 규칙:
    //   · 내 신청 목록 : where('applicantUid','==', 내uid).where('status','==', 'pending')
    //   · 주최자 화면  : where('roundupId','==', postId).where('status','==', 'pending')
    match /roundupApplications/{appId} {
      //  resource == null: 아직 없는 신청서(결정적 ID)의 존재 확인 get 허용 —
      //  신청 전 getDoc이 막히던 버그 수정. 실재하는 문서는 본인(신청자/주최자)만 read.
      allow read: if isSignedIn() && (
        resource == null
        || resource.data.applicantUid == request.auth.uid
        || resource.data.authorUid == request.auth.uid
      );

      // 신청자가 본인 이름으로 doc ID 정합성 맞춰 생성. 본인 모집엔 신청 불가.
      allow create: if isSignedIn()
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.authorUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && appId == request.resource.data.roundupId + '_' + request.resource.data.applicantUid;

      // update 3분기: 주최자 결정 / 신청자 취소 / 신청자 재신청
      // 불변 필드(roundupId·applicantUid·authorUid·createdAt) 변조 차단은 changedKeysWithin이 보장
      allow update: if isSignedIn() && (
        // (1) 주최자: pending → accepted/rejected
        (
          resource.data.authorUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'rejected']
          && changedKeysWithin(['status', 'updatedAt'])
        )
        // (2) 신청자: pending → cancelled
        || (
          resource.data.applicantUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && changedKeysWithin(['status', 'updatedAt'])
        )
        // (3) 신청자: rejected/cancelled → pending (재신청)
        || (
          resource.data.applicantUid == request.auth.uid
          && resource.data.status in ['rejected', 'cancelled']
          && request.resource.data.status == 'pending'
          && changedKeysWithin(['status', 'updatedAt'])
        )
      );

      // delete — 분쟁·이력 보존 정책상 클라이언트 삭제 불가.
      // 보관기간 만료 시 Cloud Function 정리 (Phase 2 후속).
    }

    // ===== roundupNotifications — 모집 알림 =====
    //   ※ create를 클라이언트에 열어두면 알림 스팸이 가능 —
    //     운영 단계에선 Cloud Function 생성으로 이관 권장
    match /roundupNotifications/{notiId} {
      allow read: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.recipientUid != request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid
        && changedKeysWithin(['read']);          // 읽음 처리만
      allow delete: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid;
    }

    // ===== courseComments — 골퍼 코멘트 (이미 운영 중) =====
    match /courseComments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.likes == 0;
      // 작성자: 본인 코멘트 수정 / 그 외: 좋아요 토글만
      //   likes는 ±1로만 변동 — 본인을 likedBy에 추가하면 +1, 제거하면 -1
      //   (시딩 코멘트는 likes>0·likedBy 빈 배열이라 길이 일치 검증은 못 씀)
      allow update: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid
        || (
          changedKeysWithin(['likedBy', 'likes'])
          && selfMembershipToggled('likedBy')
          && request.resource.data.likes == resource.data.likes
               + ((request.auth.uid in request.resource.data.likedBy) ? 1 : -1)
        )
      );
      allow delete: if isSignedIn()
        && resource.data.authorUid == request.auth.uid;
    }

    // ===== mannerEvaluations — 매너 평가 ([[manner-evaluation-policy]]) =====
    //  Doc ID = {roundupId}_{evaluatorUid}_{targetUid} (deterministic, 1인 1대상 1모집 1회)
    //  rating: 'good' | 'bad' (neutral=무평가는 doc 자체가 없음)
    //  익명 일괄 집계는 Cloud Functions가 처리 (48h 윈도우 후).
    //
    //  보안: 평가자 본인 read·create만. update/delete 불가 (수정 불가).
    //  대상자(target)는 자기 평가를 직접 못 읽음 — Cloud Functions가 집계 후 mannerScore에만 적용.
    match /mannerEvaluations/{evalId} {
      //  resource == null: 아직 없는 평가(결정적 ID)의 중복 확인 get 허용. 실재 문서는 평가자 본인만.
      allow read: if isSignedIn()
        && (resource == null || resource.data.evaluatorUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.evaluatorUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.roundupId is string
        && request.resource.data.rating in ['good', 'bad']
        && evalId == request.resource.data.roundupId + '_' + request.resource.data.evaluatorUid + '_' + request.resource.data.targetUid;
      allow update, delete: if false;  // 수정 불가, 보관 12개월은 Cloud Functions
    }

    // ===== noshowReports — 노쇼 신고 ([[noshow-report-system]]) =====
    //  7일 유예 → 48h 소명 → 48h 검토 → 매너 -20 + 60일/90일 정지.
    //  status: pending_grace_period | cancelled_by_reporter | explanation_required
    //          | explained | confirmed_noshow | confirmed_false_report | inconclusive
    //
    //  보안:
    //   - 신고자: 본인 신고 read·create + pending_grace_period → cancelled_by_reporter
    //   - 피신고자: 본인 대상 신고 read + explanation_required → explained (소명 제출만)
    //   - 그 외 상태 전환·정지 적용은 Cloud Functions만
    match /noshowReports/{reportId} {
      allow read: if isSignedIn() && (
        resource.data.reporterUid == request.auth.uid
        || resource.data.reportedUid == request.auth.uid
      );

      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid != request.auth.uid
        && request.resource.data.roundupId is string
        && request.resource.data.reason is string
        && request.resource.data.status == 'pending_grace_period';

      // update 2분기: 신고자 자율 취소 / 피신고자 소명 제출
      allow update: if isSignedIn() && (
        // (1) 신고자: pending_grace_period → cancelled_by_reporter
        (
          resource.data.reporterUid == request.auth.uid
          && resource.data.status == 'pending_grace_period'
          && request.resource.data.status == 'cancelled_by_reporter'
          && changedKeysWithin(['status', 'updatedAt'])
        )
        // (2) 피신고자: explanation_required → explained (소명 텍스트·자료 동봉)
        || (
          resource.data.reportedUid == request.auth.uid
          && resource.data.status == 'explanation_required'
          && request.resource.data.status == 'explained'
          && changedKeysWithin(['status', 'explanation', 'updatedAt'])
        )
      );

      allow delete: if false;  // 보관 기간 만료는 Cloud Functions ([[data-retention]])
    }

    // ===== content_reports — 게시물 신고 ([[content-report-policy]]) =====
    //  Doc ID = {targetType}_{targetId}_{reporterUid} (deterministic, 1인 1회 제한)
    //  targetType: 'courseComment' | 'roundup' | 'roundupComment'
    //  status: 'pending' | 'confirmed' | 'rejected'
    //  보안: 신고자 본인이 자기 신고 read·create. 변조·삭제는 Cloud Functions만.
    //  사용자 신고(reports)와 분리 — 한도 X, 양방향 차단 X, 부담 없는 신고.
    match /content_reports/{reportId} {
      //  resource == null: 아직 없는 신고(결정적 ID)의 중복 확인 get 허용. 실재 문서는 신고자 본인만.
      allow read: if isSignedIn()
        && (resource == null || resource.data.reporterUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetType in ['courseComment', 'roundup', 'roundupComment']
        && request.resource.data.targetId is string
        && request.resource.data.reason in ['ad_spam', 'inappropriate']
        && request.resource.data.status == 'pending'
        && reportId == request.resource.data.targetType + '_' + request.resource.data.targetId + '_' + request.resource.data.reporterUid;
      allow update, delete: if false;
    }

    // ===== reports — 사용자 신고 ([[report-block-policy]] E안) =====
    //  Doc 자동 ID. 검토 진행은 디어골프 팀(관리자) 수동·Cloud Functions 처리.
    //  status: 'pending' | 'reviewing' | 'confirmed' | 'rejected'
    //  보안: 신고자 본인만 자기 신고 조회 가능 (검토 결과 통보). 작성 후 변조·삭제 불가.
    //  클라이언트 쿼리: where('reporterUid','==', 내uid).orderBy('createdAt','desc')
    match /reports/{reportId} {
      allow read: if isSignedIn() && resource.data.reporterUid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.evidence is string
        && request.resource.data.status == 'pending';
      allow update, delete: if false;  // 검토·해결은 관리자/Cloud Functions만
    }

    // ===== locationAccessLogs — 위치정보 이용·제공사실 확인자료 =====
    //  위치정보법 제16조 제2항 — 자동 기록·보존 의무. 보존기간 6개월 (업계 관행).
    //  필드: ownerUid, providerName, purpose, accessedAt, method
    //  보안: 본인만 read (열람권). 클라이언트 작성 허용(사용 시점 기록).
    //        삭제는 Cloud Functions (6개월 만료 자동 정리) 또는 본인 철회 시.
    match /locationAccessLogs/{logId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.providerName is string
        && request.resource.data.purpose is string;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ===== banned_users — 정지 이력 보존 (재가입 차단용) =====
    // 문서 ID = 카카오 OIDC sub (kakaoId). 콘텐츠는 탈퇴 시 전부 삭제되지만
    // 정지 사실과 식별자만 별도 보존 ([[account-deletion]] A안).
    //
    // 보안: 카카오 로그인 콜백에서 본인 sub 매칭 차단용으로 read 필요.
    // write는 정지된 본인의 탈퇴 시점에 한정 — Phase 5 Cloud Functions로 이관 권장.
    //   (현재 임시 클라이언트 작성 — 위조 위험은 카카오 sub를 다른 사람의 것 알기 어려움으로 완화)
    match /banned_users/{kakaoSub} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.kakaoSub == kakaoSub
        && request.resource.data.reason is string;
      allow update, delete: if false;  // 변조 금지. 만료/해제는 Cloud Functions가 처리 ([[age-policy]] §3)
    }

    // ===== top100Courses — 100대 코스 (시딩 완료, 읽기 전용) =====
    match /top100Courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if false;     // 콘솔/관리자 스크립트로만 수정
    }

    // ===== golfCourses — 전국 골프장 마스터 (공공데이터+카카오 매칭, 읽기 전용) =====
    // 시딩: scripts/seedGolfCourses.mjs. 시딩 중에만 write 를 임시 true 로 열고, 끝나면 false 로 되돌려 배포.
    match /golfCourses/{courseId} {
      allow read: if isSignedIn();
      allow write: if false;     // 콘솔/관리자 스크립트로만 수정
    }

    // 위에 없는 모든 컬렉션은 기본 거부됨 (schedules·userCourses 등은 현재 로컬 보관)
  }
}
