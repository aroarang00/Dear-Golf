rules_version = '2';

// Firebase Storage 보안 규칙 — 아바타(프로필 사진) 친구 공개용.
// 원칙: 아바타만 허용(읽기 공개·쓰기 본인), 그 외 모든 경로는 기본 차단.
service firebase.storage {
  match /b/{bucket}/o {

    // 아바타 — avatars/{uid}/{파일명}
    //  read : 친구·다른 사용자가 명함 사진을 봐야 하므로 공개
    //  write: 본인(uid 일치)만 — 업로드=5MB 이하 이미지 / 삭제(request.resource==null)=본인 파일 정리.
    //         삭제 분기가 없으면 탈퇴 시 아바타 삭제가 항상 무음 거부돼(account.js catch 삼킴)
    //         read 공개인 탈퇴자 사진이 영구 노출됐음(2026-07-11 감사 ⑤).
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && (
                     request.resource == null
                     || (request.resource.size < 5 * 1024 * 1024
                         && request.resource.contentType.matches('image/.*'))
                   );
    }

    // 크루 프로필 이미지 — crewImages/{uid}/{파일명} (업로더=크루장 uid 경로)
    //  read : 멤버가 크루 프로필을 봐야 함 → 공개(URL은 crews.imageUrl에 담기고 그 변경은 firestore.rules상 크루장만)
    //  write: 본인(uid)만 — 업로드=5MB 이하 이미지 / 삭제(request.resource==null)=본인 파일 정리(avatars와 동일 분기)
    match /crewImages/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && (
                     request.resource == null
                     || (request.resource.size < 5 * 1024 * 1024
                         && request.resource.contentType.matches('image/.*'))
                   );
    }

    // 다이어리 사진·영상 — rounds/{uid}/{파일명} ([[friend-feed-design]] + [[diary-media-backup-plan]] 전량 백업)
    //  read : 로그인 사용자 누구나. 단 URL(다운로드 토큰 포함)은 round 문서에만 들어가고,
    //         친구공개 문서=친구만·나만보기 문서=본인만 읽을 수 있어(firestore.rules) 남은 URL을 얻을 수 없음.
    //         파일명도 난수 포함이라 경로 추측 불가.
    //  write: 본인만. 업로드=사진 10MB·영상 100MB 이하 image/*·video/* / 삭제(request.resource==null)=본인 파일 정리
    //         (다이어리 삭제·수정 시 고아 파일 즉시 삭제, 2026-07-04).
    match /rounds/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && (
                     request.resource == null
                     || (request.resource.contentType.matches('image/.*') && request.resource.size < 10 * 1024 * 1024)
                     || (request.resource.contentType.matches('video/.*') && request.resource.size < 100 * 1024 * 1024)
                   );
    }

    // DM 사진 — dmImages/{uid}/{파일명} ([[dm-design]] 사진공유)
    //  read : 로그인 사용자. URL은 conversations/{pair}/messages 문서(멤버만 read)에만 담겨 비멤버는 URL을 못 얻음(rounds와 동일 모델).
    //  write: 본인만, 이미지 10MB / 동영상 80MB 이하.
    match /dmImages/{uid}/{fileName} {
      allow read: if request.auth != null;
      //  write = 업로드(이미지 10MB·동영상 80MB) + 삭제(언센드 시 본인 파일 정리). 삭제는 request.resource==null이라 업로드 조건과 분기.
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && (
                     request.resource == null
                     || (request.resource.contentType.matches('image/.*') && request.resource.size < 10 * 1024 * 1024)
                     || (request.resource.contentType.matches('video/.*') && request.resource.size < 80 * 1024 * 1024)
                   );
    }

    // 그 외 모든 경로 차단 (명시적 deny — 실수로 열리는 것 방지)
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
