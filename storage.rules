rules_version = '2';

// Firebase Storage 보안 규칙 — 아바타(프로필 사진) 친구 공개용.
// 원칙: 아바타만 허용(읽기 공개·쓰기 본인), 그 외 모든 경로는 기본 차단.
service firebase.storage {
  match /b/{bucket}/o {

    // 아바타 — avatars/{uid}/{파일명}
    //  read : 친구·다른 사용자가 명함 사진을 봐야 하므로 공개
    //  write: 본인(uid 일치)만, 5MB 이하, 이미지 타입만 (남용·비이미지 차단)
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // 그 외 모든 경로 차단 (명시적 deny — 실수로 열리는 것 방지)
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
